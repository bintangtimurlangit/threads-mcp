# ─────────────────────────────────────────────────────────────────────────────
# Threads MCP — Environment Variables
#
# This server drives a real Chromium profile so it can pass Meta's anti-bot
# checks and act as YOUR logged-in Threads account. You log in ONCE with
# `npm run login`; the session (cookies) is saved to the profile dir below and
# reused. Everything here is optional.
#
# ⚠️  RATE LIMITS: You are automating a real account. Meta aggressively rate-
#     limits and can action accounts for burst/automation-like behavior. Keep
#     THREADS_MIN_ACTION_INTERVAL_MS high, avoid rapid write loops, and treat
#     posting/following as scarce. See README "Behave for rate limits".
# ─────────────────────────────────────────────────────────────────────────────

# Threads domain (default: threads.com — threads.net redirects here).
THREADS_DOMAIN=threads.com

# Where the persistent Chromium profile (your saved login) lives.
# Default: ~/.threads-mcp/chrome-profile
# THREADS_PROFILE_DIR=/home/you/.threads-mcp/chrome-profile

# The browser runs HEADED by default because Meta detects headless — keep it
# that way. On a server, provide a virtual display via `xvfb-run`. Setting this
# to "true" is for experiments only and will very likely be blocked.
THREADS_HEADLESS=false

# Minimum gap (ms) the server enforces between WRITE actions (post, reply, like,
# repost, follow, delete). This is your safety rail against bursty automation.
# Default: 8000 (8s). Raise it if you want to be extra safe.
THREADS_MIN_ACTION_INTERVAL_MS=8000

# Cache lifetime in milliseconds for READ results (default: 30000 = 30s).
CACHE_TTL_MS=30000

# Set to "true" to log startup/debug info (incl. captured GraphQL names) to stderr.
DEBUG=false
